#!name = Shiina 去广告补充（V2）
#!desc = v0.2.0｜补充微博国际版开屏广告、广告配置和信息流广告开关。已完成本地样本回放，实际去广告效果待真机验证。
#!author = ShiinaWong
#!homepage = https://github.com/ShiinaWong/stash-configs/tree/main/loon
#!raw-url = https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/shiina-adblock-supplement.plugin
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-10-26
#!tag = 去广告,补充,Shiina
#!type = normal

# 奶思大合集的独立补充，固定订阅地址保持不变。
# 本版只处理本次抓包确认的 3 个接口；2 个精确 MitM 主机。
# 不修改登录、会员、普通微博正文、评论、视频和代理配置。
# 信息流只调整已观察到的广告配置开关，尚无时间线卡片过滤。
# 禁止将原始抓包、Cookie、Token 或节点凭据提交至公开仓库。

[Argument]
weibo_intl = switch,true,tag=微博国际版补充,desc=开屏广告列表与广告配置；关闭后停止本插件的微博脚本
weibo_intl_feed = switch,true,tag=微博国际版信息流广告开关,desc=仅调整配置中的五个广告开关；客户端效果待验证

[Rule]
# 不封锁共享业务域名。

[Rewrite]
# 本版以结构检查后的响应脚本处理 JSON。

[Script]
# 微博国际版：开屏预加载。仅清空成功响应的 ads 数组。
response if ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload(?:\?|$)/ && ${request.method} == "POST" && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/weibo-intl-ad-clean.js") with enable=${weibo_intl}, requires_body=true, timeout=5, tag="Shiina-微博国际版-开屏"
# 微博国际版：补充当前实际主机；查询参数可以换序。
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^&#]*&)*a=get_coopen_ads(?:&|$)/ && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/weibo-intl-ad-clean.js") with enable=${weibo_intl}, requires_body=true, timeout=5, tag="Shiina-微博国际版-广告配置"
# 微博国际版：配置层补充，不过滤时间线正文；可独立关闭。
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^&#]*&)*a=open_app(?:&|$)/ && ${request.method} == "GET" && ${response.status} == 200 && ${weibo_intl_feed} == true then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/weibo-intl-ad-clean.js") with enable=${weibo_intl}, requires_body=true, timeout=5, tag="Shiina-微博国际版-信息流配置"

[Mitm]
hostname = bootpreload.uve.weibo.com, weibointl.api.weibo.cn
