#!name = Shiina 去广告补充（V2）
#!desc = v0.6.0｜奶思为主，补中国联通墨迹天气车来了；新增微信抓包确认的四张度小满广告素材拦截。素材拦截不保证移除卡片占位，各组独立开关。
#!author = ShiinaWong；规则及字段参考：ddgksf2013；微博：ddgksf2013、zmqcherish
#!homepage = https://github.com/ShiinaWong/stash-configs/tree/main/loon
#!raw-url = https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/shiina-adblock-supplement.plugin
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-10-29
#!tag = 去广告,补充,Shiina
#!type = normal

# 参考 ddgksf2013/Rewrite/AdBlock/WeiboAds.conf V2.0.114。
# 直接引用 ddgksf2013/Scripts/weibo_json.js V2.0.142；固定提交以便复核。
# 不复制原脚本，不引入个人主页、会员皮肤、搜索页整体改造等入口。
# 相同接口不要同时启用另一份微博专用插件；响应脚本不是串行叠加。
# 原始抓包、Cookie、Token、个人配置及节点凭据不得提交至公开仓库。

[Argument]
weibo_intl = switch,true,tag=微博净化脚本与复写,desc=控制本插件微博 Script 和 Rewrite；完整停用（含分流与 MitM）请关闭整个插件
weibo_intl_feed = switch,true,tag=微博信息流与详情广告,desc=启用墨鱼时间线和卡片过滤及 open_app 详情横幅处理；不再猜测五个广告开关

amap_clean = switch,true,tag=高德页面净化,desc=清理推广与部分推荐和 AI 入口；保留实际路线计算和地图业务接口
caiyun_clean = switch,true,tag=彩云页面净化,desc=清理首页推广和发现页推荐；保留天气预报及会员信息
netdisk_clean = switch,true,tag=网盘页面净化,desc=清理广告配置与任务推广；首页精简为文件功能和最近记录
goofish_clean = switch,true,tag=闲鱼广告补充,desc=补 g-acs 开屏和搜索推广及商品推荐广告；奶思已有的信息流继续由奶思处理
mailmaster_clean = switch,true,tag=网易邮箱大师推广,desc=清理页面运营推广和任务悬浮入口；保留登录引导及账号信息
qishui_clean = switch,true,tag=汽水音乐推广,desc=清理广告请求和奖励横幅及热门搜索活动；保留歌曲流与付费接口
tencentdocs_clean = switch,true,tag=腾讯文档广告,desc=拦截文档服务下的专用广告路径；不修改文档内容
taopiaopiao_clean = switch,true,tag=淘票票推广,desc=清理广告预加载和横幅及启动弹窗；保留电影推荐和购票功能
idaily_clean = switch,true,tag=iDaily 系列推广,desc=清理 iDaily 和 iDays 开屏及同系应用交叉推广
unicom_clean = switch,true,tag=中国联通推广,desc=清理热搜和首页营销背景商城角标及新人推广；保留钱包积分和账户服务
moji_clean = switch,true,tag=墨迹天气推广,desc=补浮窗商品推广和 banner 区；保留天气工具发现页及短视频；仅匹配 api.moji.com 子域名
chelaile_clean = switch,true,tag=车来了广告补充,desc=补小程序推广位和详情信息流及 CDN 广告接口；保留公交查询路线规划和原有底栏

wechat_dxm_assets = switch,true,tag=微信度小满广告素材,desc=仅拦截抓包确认的四张素材；不能保证移除广告文字和占位；不拦截整个微信图片域名

[Rule]
# 与 Quantumult 微博配置保持一致：SDK 返回交给脚本处理。
DOMAIN,sdkapp.uve.weibo.com,DIRECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN-SUFFIX,api.touch-moblie.com,REJECT

[Rewrite]
# 实时开屏、专用广告接口与 SDK 配置；预加载由下方脚本处理。
request if ${weibo_intl} == true && ${url} ~= /^https?:\/\/(?:bootpreload\.uve|bootrealtime\.uve|boot\.biz)\.weibo\.com\/v\d+\/ad\/realtime(?:\?|$)/ then reject(200)
request if ${weibo_intl} == true && ${url} ~= /^https?:\/\/m?api\.weibo\.c(?:n|om)\/\d+\/ad\/(?:preload|weibointl)(?:\?|$)/ then reject_dict(200)
request if ${weibo_intl} == true && ${url} ~= /^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php(?:\?|$)/ then reject(404)

# 高德：仅补充奶思未处理的推广接口；不接管其 valueadded 开屏拦截。
request if ${amap_clean} == true && ${url} ~= /^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/v\d+\/ai_rec\// then reject_dict(200)
request if ${amap_clean} == true && ${url} ~= /^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/(?:faas\/amap-navigation\/card-service-route-plan|shield\/scene\/recommend)\/?(?:\?|$)/ then reject_dict(200)
request if ${amap_clean} == true && ${url} ~= /^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/(?:boss\/order_web\/\w{8}_information|asa\/ads_attribution)\/?(?:\?|$)/ then reject(200)
# 彩云：活动接口仍由奶思处理，此处仅拦截独立广告服务。
request if ${caiyun_clean} == true && ${url} ~= /^https?:\/\/ad\.cyapi\.cn\/v\d+(?:\/|\?|$)/ then reject(200)
# 网盘：只补专用推荐入口；不整段拦截 getconfig、账号或会员接口。
request if ${netdisk_clean} == true && ${url} ~= /^https?:\/\/pan\.baidu\.com\/(?:feed\/hotlist|queryintent\/queryhint|coins\/center\/notice)\/?(?:\?|$)/ then reject(200)
request if ${netdisk_clean} == true && ${url} ~= /^https?:\/\/pan\.baidu\.com\/recommend\/shortseries\/list\/?(?:\?|$)/ then reject_dict(200)

# v0.5.0：对照奶思 V2，只补缺少的主机/接口。各项来源与取舍见 docs/moyu-third-batch.md。
# 闲鱼：acs 的 splash 已由奶思拦截；不增加 AMDC/HTTPDNS 处理。
request if ${goofish_clean} == true && ${url} ~= /^https?:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads(?:\/\d+(?:\.\d+)*)?\/?(?:\?|$)/ then reject(200)
request if ${goofish_clean} == true && ${url} ~= /^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose(?:\/\d+(?:\.\d+)*)?\/?(?:\?|$)/ then reject(200)
# 邮箱：仅任务推广/悬浮图标，登录配置与 user/info 保持原状。
request if ${mailmaster_clean} == true && ${url} ~= /^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task(?:\/|\?|$)/ then reject_dict(200)
request if ${mailmaster_clean} == true && ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do(?:\?|$)/ then reject_dict(200)
# 汽水：使用两个明确的业务主机；不拦截 commerce、位置服务或 TNC。
request if ${qishui_clean} == true && ${url} ~= /^https?:\/\/(?:beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/(?:media_ads|ads)(?:\/|\?|$)/ then reject(200)
# 腾讯文档：限定 URL 路径，查询参数里出现 /ad/ 不应误伤正常文档。
request if ${tencentdocs_clean} == true && ${url} ~= /^https?:\/\/docs\.qq\.com\/(?:(?:[^\/?#]+\/)+ad\/|api\/advertise\/)/ then reject(404)
# iDaily 系列：保留正文接口，仅采用作者列出的广告路径。
request if ${idaily_clean} == true && ${url} ~= /^https?:\/\/idaily-cdn\.idailycdn\.com\/api\/intro(?:\/|\?|$)/ then reject(200)
request if ${idaily_clean} == true && ${url} ~= /^https?:\/\/icity-pres\.2q10\.com\/api\/v\d+\/idly\/common\/launching\/?(?:\?|$)/ then reject(200)
request if ${idaily_clean} == true && ${url} ~= /^https?:\/\/idaily-cdn\.idailycdn\.com\/app\/idaily_portable\/honored\/?(?:\?|$)/ then reject(200)
request if ${idaily_clean} == true && ${url} ~= /^https?:\/\/app-cdn\.2q10\.com\/app\/idays\/popups\/?(?:\?|$)/ then reject(200)
request if ${idaily_clean} == true && ${url} ~= /^https?:\/\/idays-cdn\.2q10\.com\/app\/idays\/app_ad\/?(?:\?|$)/ then reject(200)

# v0.6.0：保留联通账户/钱包/积分和客服接口，仅拦截明确的新人优惠推广。
request if ${unicom_clean} == true && ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientIndex\/api\/v1\/index\/queryIndexExclusiveOffers\/?(?:\?|$)/ then reject(404)
# 墨迹：按作者 API 子域名范围补缺，排除奶思已拒绝的 me/ad/fds；不处理 TNC 或整页内容。
request if ${moji_clean} == true && ${url} ~= /^https?:\/\/(?![^\/?#]*me\.api\.moji\.com)(?!(?:ad|(?:[a-z0-9-]+\.)*fds)\.api\.moji\.com\/)(?:[a-z0-9-]+\.)+api\.moji\.com\/flycard\/flyCard(?:\/|\?|$)/ then reject(200)
request if ${moji_clean} == true && ${url} ~= /^https?:\/\/(?![^\/?#]*me\.api\.moji\.com)(?!(?:ad|(?:[a-z0-9-]+\.)*fds)\.api\.moji\.com\/)(?:[a-z0-9-]+\.)+api\.moji\.com\/json\/advertising_goods(?:\/|\?|$)/ then reject(200)
# 车来了：不重复奶思 api/adpub、web/api/adpub/ad 和 atrace 域名拒绝，也不接管共享 IP。
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/(?:(?:cdn\.)?(?:api|web))\.chelaile\.net\.cn\/goocity\/flowPos\/listByPos\/?(?:\?|$)/ then reject(404)
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html(?:\?|$)/ then reject(200)
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/cdn\.(?:api|web)\.chelaile\.net\.cn\/(?:api\/)?adpub(?:\/|\?|$)/ then reject(200)
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/web\.chelaile\.net\.cn\/adpub(?:\/|\?|$)/ then reject(200)
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/api\.chelaile\.net\.cn\/api\/adpub(?:\/|\?|$)/ then reject(200)
request if ${chelaile_clean} == true && ${url} ~= /^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow\/?(?:\?|$)/ then reject(200)

# 微信：只拦截本次目视确认的三张度小满广告横幅和一张品牌客服图。
# 素材 ID 不含登录/追踪参数；未知素材、文章链接和微信通信不处理。
request if ${wechat_dxm_assets} == true && ${url} ~= /^https?:\/\/wximg\.wxs\.qq\.com\/141\/20204\/snscosdownload\/SZ\/reserved\/(?:6a98f4ff00064c2c2b4bef679a68bc1e0000008d00004eec|6abce3f5000becb30d0176c02668bc1e0000008d00004eec|6ae0150e000b368d0ecef4e1820155150000008d00004eec|6a9a2dd6000a79921bc5dad63b6bae1e0000008d00004eec)(?:\?|$)/ then reject(404)

[Script]
# 开屏保留广告 ID，调整展示日期、时长与次数；get_coopen_ads 返回 data={display_ad:1}。
# SDK PHP 保留原脚本的 OK 后缀；open_app 的 a 参数需位于首位，与当前抓包一致。
# 时间线、卡片沿用上游广告与推荐元素过滤；不再使用 v0.2.0 的五个字段推测。
response if ${url} ~= /^https?:\/\/(?:bootpreload\.uve|bootrealtime\.uve|boot\.biz)\.weibo\.com\/v\d+\/ad\/preload(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼开屏"
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.c(?:n|om)\/portal\.php\?(?:[^&#]*&)*a=get_coopen_ads(?:&|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼广告配置"
response if ${url} ~= /^https?:\/\/(?:sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php|wbapp\.uve\.weibo\.com\/wbapplua\/wbpullad\.lua)(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼SDK"
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=open_app(?:&|$)/ && ${response.status} == 200 && ${weibo_intl_feed} == true then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼详情横幅"
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(?:n|om)\/\d+\/(?:statuses\/(?:friends\/timeline|friends_timeline|unread_friends_timeline|unread_hot_timeline)|groups\/timeline)(?:\?|$)/ && ${response.status} == 200 && ${weibo_intl_feed} == true then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼时间线"
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(?:n|om)\/\d+\/cardlist(?:\?|$)/ && ${response.status} == 200 && ${weibo_intl_feed} == true then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼卡片"
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(?:n|om)\/\d+\/statuses\/(?:container_timeline|container_timeline_topic|video_mixtimeline)(?:\?|$)/ && ${response.status} == 200 && ${weibo_intl_feed} == true then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/weibo_json.js") with enable=${weibo_intl}, requires_body=true, timeout=10, tag="Shiina-微博-墨鱼新版信息流"

# 高德仅使用已审阅的 QX 同源脚本；主机范围与原 QX MitM 列表一致。
response if ${url} ~= /^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/(?:message\/notice\/list|shield\/frogserver\/aocs\/updatable|shield\/search\/nearbyrec_smart|promotion-web\/resource|faas\/amap-navigation\/main-page|msgbox\/pull|shield\/dsp\/profile\/index\/nodefaas|shield\/search\/new_hotword)\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/0cddbb6bc31344315afba773ebb4e7ce29f7fd8f/amap.js") with enable=${amap_clean}, requires_body=true, timeout=10, tag="Shiina-高德-墨鱼页面净化"
# 彩云和网盘参考 QX 广告处理；保留响应封装，不使用原脚本会员修改或固定推广内容。
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d+\/(?:operation\/(?:homefeatures|banners|features|feeds)|notification\/message_center|config\/cypage|campaigns)\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/qx-extra-clean-v0.4.0.js") with enable=${caiyun_clean}, requires_body=true, timeout=10, tag="Shiina-彩云-页面推广"
response if ${url} ~= /^https?:\/\/pan\.baidu\.com\/(?:api\/getsyscfg|feed\/cardinfos|api\/taskscore\/tasklist)\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/qx-extra-clean-v0.4.0.js") with enable=${netdisk_clean}, requires_body=true, timeout=10, tag="Shiina-网盘-页面推广"

# 闲鱼缺口：只补 g-acs 上奶思没有处理的四类接口；recommend.list 留给奶思。
response if ${url} ~= /^https?:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.(?:idle\.user\.strategy\.list|idlemtopsearch\.(?:search\.(?:shade|discover)|item\.search\.activate))(?:\/\d+(?:\.\d+)*)?\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${goofish_clean}, requires_body=true, timeout=10, tag="Shiina-闲鱼-搜索与悬浮推广"
response if ${url} ~= /^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend(?:\/\d+(?:\.\d+)*)?\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${goofish_clean}, requires_body=true, timeout=10, tag="Shiina-闲鱼-商品推荐广告"
# 邮箱保留登录引导和扩展配置；汽水不按 track 白名单清空其他音乐内容。
response if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/[^?#]*conf\.do(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${mailmaster_clean}, requires_body=true, timeout=10, tag="Shiina-邮箱大师-页面推广"
response if ${url} ~= /^https?:\/\/(?:beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/(?:me|search-block|activities)\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${qishui_clean}, requires_body=true, timeout=10, tag="Shiina-汽水音乐-页面推广"
# 淘票票不重复处理奶思的 queryloadingbanner；保留首页猜你喜欢和搜索配置。
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.(?:independentadvertiseapi\.querypreloadadvertise|mtop(?:independent|item)advertiseapi\.queryadvertise|life\.(?:aristotle|popup)\.get)(?:\/\d+(?:\.\d+)*)?\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${taopiaopiao_clean}, requires_body=true, timeout=10, tag="Shiina-淘票票-推广补充"
response if ${url} ~= /^https?:\/\/app-cdn\.2q10\.com\/app\/\w+\/honored\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.5.0.js") with enable=${idaily_clean}, requires_body=true, timeout=10, tag="Shiina-iDaily-交叉推广"

# 中国联通仅改作者明确列出的营销字段，不清空我的页或任何业务账户信息。
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/(?:search_service\/search\/searchScrollWord|clientIndex\/homefusion\/fuInter)\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.6.0.js") with enable=${unicom_clean}, requires_body=true, timeout=10, tag="Shiina-中国联通-营销补充"
# 墨迹只过滤 banner 区；保留作者原规则还会删除的工具区、我页面灯泡及未知区域。
response if ${url} ~= /^https?:\/\/(?![^\/?#]*me\.api\.moji\.com)(?!(?:ad|(?:[a-z0-9-]+\.)*fds)\.api\.moji\.com\/)(?:[a-z0-9-]+\.)+api\.moji\.com\/json\/entrance\/list\/?(?:\?|$)/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/moyu-extra-clean-v0.6.0.js") with enable=${moji_clean}, requires_body=true, timeout=10, tag="Shiina-墨迹天气-横幅补充"

[Mitm]
