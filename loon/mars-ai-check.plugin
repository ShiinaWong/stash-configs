#!name = Mars AI 链路快检
#!desc = v1.0.2 · 修复节点列表，提供 AI 快检、GPT 专项检查和精简排障摘要。打开 http://mars.loon.test/ 使用。
#!author = shiina / ChatGPT
#!homepage = https://github.com/ShiinaWong/stash-configs/blob/main/loon/docs/mars-ai-check.md
#!openUrl = http://mars.loon.test/
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-11
#!tag = 工具,网络诊断

# GitHub 订阅版：Loon 根据下方远程 URL 获取配套脚本。更新插件后核对面板版本。
# 不修改 AI 分流、代理链、节点凭据或 MitM。没有定时任务。

[Host]
mars.loon.test = 127.0.0.1

[Rule]
DOMAIN,mars.loon.test,DIRECT

[Script]
request if ${url} ~= /^http:\/\/mars\.loon\.test(?::80)?\//i then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/mars-ai-check-v1.0.2.js") with requires_body=true, timeout=35, tag="Mars AI 控制面板"
generic then script("https://raw.githubusercontent.com/ShiinaWong/stash-configs/main/loon/scripts/mars-ai-check-v1.0.2.js", "action=check") with timeout=35, tag="Mars AI 快检", img_url="network.system"
